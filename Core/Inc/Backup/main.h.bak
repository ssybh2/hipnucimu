#define IMU_RST_Pin GPIO_PIN_11
#define IMU_RST_GPIO_Port GPIOB
#define LED_Pin GPIO_PIN_15
#define LED_GPIO_Port GPIOB

/* USER CODE BEGIN Private defines */
struct packet_0x01_t {
    float q0;
    float q1;
} __attribute__((packed));

struct packet_0x02_t {
    float q2;
    float q3;
} __attribute__((packed));

struct packet_0x03_t {
    float gyro0;
    float gyro1;
} __attribute__((packed));

struct packet_0x04_t {
    float gyro2;
    float accel0;
} __attribute__((packed));

struct packet_0x05_t {
    float accel1;
    float accel2;
} __attribute__((packed));

#define U1(p) (*((uint8_t *)(p)))
#define I1(p) (*((int8_t *)(p)))
#define I2(p) (*((int16_t *)(p)))
static uint16_t U2(uint8_t *p) {uint16_t u; memcpy(&u,p,2); return u;}
static uint32_t U4(uint8_t *p) {uint32_t u; memcpy(&u,p,4); return u;}
static int32_t I4(uint8_t *p) {int32_t u; memcpy(&u,p,4); return u;}
static float R4(uint8_t *p) {float r; memcpy(&r,p,4); return r;}
typedef struct
{
    uint8_t tag; /* item tag: 0x91 */
    float acc[3]; /* acceleration */
    float gyr[3]; /* angular velocity */
    float mag[3]; /* magnetic field */
    float eul[3]; /* attitude: eular angle */
    float quat[4]; /* attitude: quaternion */
    float pressure; /* air pressure */
    uint32_t timestamp;
}imu_data_t;

